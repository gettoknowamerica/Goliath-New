# Goliath Omni — local runtime config. Copy to goliath.env and fill in.
# NOTHING here points at a paid LLM. Twilio + Resend are the only paid services.

# ---------- Local LLM ----------
OLLAMA_HOST=http://127.0.0.1:11434
MODEL_FAST=qwen2.5:7b
MODEL_ALT=llama3.1:8b
MODEL_VISION=gemma3:4b
MODEL_LONGFORM=gpt-oss:20b
MODEL_EMBED=nomic-embed-text
MODEL_REASON=deepseek-r1:8b

# Long-form model does not fit in 10GB VRAM. Only allowed inside this window.
LONGFORM_WINDOW_START=23
LONGFORM_WINDOW_END=7

# ---------- GPU ----------
GPU_LOCK_FILE=F:\GoliathOmni\runtime\gpu.lock
GPU_TOTAL_VRAM_GB=10

# ---------- Paths (verified) ----------
COMFY_ROOT=F:\Mark Pires\ComfyUI
MEDIA_INBOX=F:\Mark Pires\ComfyUI\input\Inbox
MEDIA_WORK=F:\GoliathOmni\media\work
MEDIA_OUT=F:\GoliathOmni\exports
WHISPERX_DIR=F:\GoliathOmni\whisperX
DEMUCS_DIR=F:\GoliathOmni\demucs
REMOTION_DIR=F:\GoliathOmni\remotion
FFMPEG_BIN=F:\GoliathOmni\ai-ffmpeg\bin\ffmpeg.exe
FFPROBE_BIN=F:\GoliathOmni\ai-ffmpeg\bin\ffprobe.exe
VENV_PY=F:\GoliathOmni\venv\Scripts\python.exe

# ---------- App ----------
APP_PORT=3000
MISSION_CONTROL_PATH=/mission-control/
RECEIVER_PORT=8787
UPLOAD_RECEIVER_TOKEN=

# ---------- System of record (Hostinger MySQL) ----------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---------- Local services already on F: ----------
QDRANT_URL=http://127.0.0.1:6333
MEILI_URL=http://127.0.0.1:7700
N8N_URL=http://127.0.0.1:5678
COMFY_URL=http://127.0.0.1:8188
KOKORO_URL=http://127.0.0.1:8880
CRAWL4AI_URL=http://127.0.0.1:11235

# ---------- Paid services that STAY ----------
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
