# LeadForge / Mission Control — environment template (local deployment)
# Copy to .env and fill in. NO REAL VALUES HERE — this is a template only.
# Required = the app needs a value to run at its best. Optional = feature keys;
# the core lead engine (CSV import, DNC suppression, scoring, enrichment with
# local Trafilatura fallback, call sheets) runs with ZERO external keys.

# ── CORE (REQUIRED) ──────────────────────────────────────────────────────────
# Base path the app serves under. "/" = at the domain root (cto.new preview
# behavior, unchanged). "/mission-control" = the whole app under
# https://markpires.com/mission-control/* (the local home deployment).
APP_BASE_PATH=/mission-control

# Public URL of this deployment. Used in email links, unsubscribe URLs, and
# content canonical URLs. Local deployment: https://markpires.com
LEADFORGE_SITE_URL=https://markpires.com

# Signs the httpOnly session cookie (HMAC-SHA256). REQUIRED — generate a fresh
# random one for your install (e.g. `openssl rand -hex 32`). Rotating it ends
# all sessions.
SESSION_SECRET=change-me-64-hex-chars

# The seeded admin (mark@markpires.com) starts with THIS generic password.
# First login FORCES a password change. NOTE: change this before first login is
# not possible — the app forces it — but pick a strong value anyway; anyone who
# reads your .env before you log in could log in as admin.
ADMIN_INITIAL_PASSWORD=change-me-strong-password

# ── OLLAMA — the local AI brain (REQUIRED for local-AI features) ─────────────
# Base URL of the Ollama server on the home PC (native API). The app uses it
# for /api/tags + /api/chat via src/lib/ollama.ts and the /api/ai/health check.
OLLAMA_BASE_URL=http://localhost:11434
# Model used for chat. Default llama3.1:8b fits the RTX 3080 (10GB VRAM).
# Glimmer 30B Q4 (~18GB) does NOT fit 10GB VRAM — it needs a bigger card or
# CPU-only patience. Run `ollama pull llama3.1:8b` after installing Ollama.
OLLAMA_MODEL=llama3.1:8b
# OPTIONAL — OpenAI-compatible alias (same Ollama server, /v1 surface) used by
# the AI email drafter (src/email.ts). Without it, email drafts use the
# deterministic template. Set to your Ollama base URL to enable local AI drafts.
# OLLAMA_URL=http://localhost:11434

# ── EMAIL (OPTIONAL — feature keys) ──────────────────────────────────────────
# Resend — outbound email. Without RESEND_API_KEY the app never sends; all
# outbound sends require the owner's explicit approval of the final text
# (email governance) regardless.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_EMAIL_FROM=Mark Pires <mark@markpires.com>
# RESEND_WEBHOOK_SECRET=change-me
# EMAIL_UNSUB_SECRET=change-me
# EMAIL_FOOTER=Mark Pires · markpires.com

# ── ENRICHMENT (OPTIONAL — feature keys) ─────────────────────────────────────
# Default search provider is duckduckgo (free). Set SEARCH_PROVIDER=firecrawl
# only when a Firecrawl key is present. The app always falls back to local
# Trafilatura scraping when no key is available.
# SEARCH_PROVIDER=duckduckgo
# FIRECRAWL_API_KEY=fc-xxxxxxxx
# FIRECRAWL_URL=https://api.firecrawl.dev

# ── CALL LISTS (OPTIONAL — reserved) ─────────────────────────────────────────
# Twilio — phone call features. NOT currently read by app code; reserved for
# the future call pipeline. Leave unset unless/until that ships.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=change-me
# TWILIO_FROM_PHONE=+1203xxxxxxx

# ── CONTENT (OPTIONAL) ───────────────────────────────────────────────────────
# Canonical base for exported SEO content pages + social OG image URL.
# POST_CANONICAL_BASE=https://markpires.com/exports/content
# OG_IMAGE_URL=

# ── MEDIA / GPU BOX (OPTIONAL — feature keys) ────────────────────────────────
# ComfyUI (owner's Windows GPU box). LOCAL: use http://localhost:8188 when
# ComfyUI runs on the same PC; use a Cloudflare tunnel URL when accessing a
# remote box. Note: Quick tunnel URLs ROTATE on every cloudflared restart.
# COMFYUI_BASE_URL=http://localhost:8188
# Chunked upload receiver (Windows box, F: drive). Empty = the app stores
# uploads on its own disk (.data/media). UPLOAD_RECEIVER_TOKEN must match the
# receiver's config.json TOKEN.
# UPLOAD_RECEIVER_URL=
# UPLOAD_RECEIVER_TOKEN=change-me

# ── YOUTUBE (OPTIONAL — tooling only, not the app) ───────────────────────────
# Used by the archive-inventory scripts (Columbo), not by the app server.
# YOUTUBE_API_KEY=AIzaSyxxxxxxxx

# ── LEGACY ALIAS (OPTIONAL) ──────────────────────────────────────────────────
# SITE_URL is a legacy alias for LEADFORGE_SITE_URL; not needed when the
# LEADFORGE_SITE_URL above is set.
# SITE_URL=https://markpires.com
