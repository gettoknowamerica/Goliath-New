# LeadForge local deployment env (copy to .env and fill in)
# REQUIRED:
ADMIN_INITIAL_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-long-random-string
LEADFORGE_SITE_URL=https://markpires.com

# Routing (leave as-is for this kit):
APP_BASE_PATH=/mission-control

# Local AI brain (Ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional integrations (blank = disabled):
# RESEND_API_KEY=
# FIRECRAWL_API_KEY=
# FIRECRAWL_URL=https://api.firecrawl.dev
# SEARCH_PROVIDER=duckduckgo
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# EMAIL_UNSUB_SECRET=
# EMAIL_FOOTER=
# COMFYUI_BASE_URL=
# OG_IMAGE_URL=
# POST_CANONICAL_BASE=
# UPLOAD_RECEIVER_HOST=
# UPLOAD_RECEIVER_PORT=
